# ---------------------------------------------------------------------------
# trade-ai ortam degiskenleri. Bu dosyayi .env olarak kopyalayip doldur.
# Coolify kullaniyorsan bunlari Coolify'in "Environment Variables" ekranina gir.
# ---------------------------------------------------------------------------

# --- Genel ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=Europe/Istanbul

# --- PostgreSQL ---
POSTGRES_USER=tradeai
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tradeai
# api ve worker container'lari bu URL'i kullanir (host adi = compose servis adi)
DATABASE_URL=postgresql+asyncpg://tradeai:change-me-in-production@postgres:5432/tradeai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Gemini / LLM degerlendirme ---
# Harcama guvenligi: anahtar tanimli olsa bile LLM_ENABLED=true olmadan cagri yapilmaz.
GEMINI_API_KEY=
GEMINI_MODEL_TIER1=gemini-3.7-flash
GEMINI_MODEL_TIER2=gemini-3.1-pro-preview
LLM_ENABLED=false
LLM_BATCH_SIZE=20
LLM_MAX_ATTEMPTS=3
LLM_TIER2_MIN_IMPACT=70
LLM_DAILY_INPUT_TOKEN_LIMIT=500000
LLM_DAILY_OUTPUT_TOKEN_LIMIT=100000
LLM_MAX_SOURCE_CHARS=12000

# --- Frontend ---
# Host portlari. Baska servislerle cakisirsa sadece sol (host) portu degistir.
API_PORT=8000
WEB_PORT=3000
# Tarayicidan erisilen API adresi. Yerelde localhost, prod'da kendi domainin.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Bildirim (Faz 10) ---
N8N_WEBHOOK_URL=

# --- Toplayici ayarlari ---
# KAP bazi isteklerde User-Agent/Referer bekliyor; kendini tanit.
COLLECTOR_USER_AGENT=trade-ai/0.1 (kisisel arastirma)
KAP_RATE_LIMIT_PER_SEC=2
