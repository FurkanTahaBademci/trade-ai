# ---------------------------------------------------------------------------
# trade-ai ortam degiskenleri.
# En kolay yol: `make init` -> bu dosyadan .env uretir ve parolalari rastgele doldurur.
# Elle kuruyorsan .env olarak kopyalayip bos/ornek secret'lari doldur.
# Coolify kullaniyorsan bunlari Coolify'in "Environment Variables" ekranina gir.
# Ayrintilar: docs/CONFIGURATION.md ve docs/ADMIN.md
# ---------------------------------------------------------------------------

# --- Genel ---
ENVIRONMENT=development
LOG_LEVEL=INFO
TZ=Europe/Istanbul
# Virgulle ayrilmis tam origin/host listeleri. Coolify domainlerini production'da yaz.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,api

# --- PostgreSQL ---
POSTGRES_USER=tradeai
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=tradeai
# api ve worker container'lari bu URL'i kullanir (host adi = compose servis adi)
DATABASE_URL=postgresql+asyncpg://tradeai:change-me-in-production@postgres:5432/tradeai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Gemini / LLM degerlendirme ---
# Harcama guvenligi: anahtar tanimli olsa bile LLM_ENABLED=true olmadan cagri yapilmaz.
GEMINI_API_KEY=
GEMINI_API_MODE=interactions
GEMINI_MODEL_TIER1=gemini-3.8-flash
GEMINI_MODEL_TIER2=gemini-3.1-pro-preview
LLM_ENABLED=false
LLM_BATCH_SIZE=20
LLM_TIER1_GROUP_SIZE=5
LLM_MAX_ATTEMPTS=3
LLM_TIER2_MIN_IMPACT=70
LLM_DAILY_INPUT_TOKEN_LIMIT=500000
LLM_DAILY_OUTPUT_TOKEN_LIMIT=100000
LLM_MAX_SOURCE_CHARS=12000

# --- Frontend ---
# Host portlari. Baska servislerle cakisirsa sadece sol (host) portu degistir.
API_PORT=8000
WEB_PORT=3000

# --- Bildirim ---
N8N_WEBHOOK_URL=
# Ayni sistem sorunu icin tekrar bildirimden once beklenecek sure.
MONITORING_ALERT_COOLDOWN_SECONDS=3600

# --- Yonetim erisimi (bkz. docs/ADMIN.md) ---
# Backend yazma uclarini (takvim, ayarlar, backtest) koruyan anahtar.
# En az 32 karakter; uretmek icin: openssl rand -hex 32
# Bos + ENVIRONMENT=development -> yazma uclari korumasiz (yalniz yerel kullanim).
# Bos + ENVIRONMENT=production  -> yazma uclari HTTP 503 ile kapali.
ADMIN_API_TOKEN=
# /sistem ve /backtest sayfalari icin tarayici giris penceresi (HTTP Basic Auth).
# En az 16 karakter; uretmek icin: openssl rand -base64 24
# Docker imajindaki web her zaman production modunda calisir: bu parola da
# ADMIN_API_TOKEN da bossa yonetim sayfalari HTTP 503 doner.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=

# --- Container kaynak limitleri (Coolify/Compose) ---
POSTGRES_MEMORY_LIMIT=2G
REDIS_MEMORY_LIMIT=512M
API_MEMORY_LIMIT=1G
WORKER_MEMORY_LIMIT=2G
WEB_MEMORY_LIMIT=512M

# --- Toplayici ayarlari ---
# KAP bazi isteklerde User-Agent/Referer bekliyor; kendini tanit
# (or. iletisim adresi veya repo linki ekleyebilirsin).
COLLECTOR_USER_AGENT=trade-ai (acik kaynak arastirma araci)
KAP_RATE_LIMIT_PER_SEC=2
